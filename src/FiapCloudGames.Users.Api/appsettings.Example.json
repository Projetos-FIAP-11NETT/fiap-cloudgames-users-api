{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=<db-host>;Port=<db-port>;Database=<db-name>;Username=<db-user>;Password=<db-password>"
  },
  "Firebase": {
    "CredentialPath": "<caminho-para-firebase-service-account.json>",
    "ApiKey": "<firebase-web-api-key>"
  },
  "SqsSettings": {
    "Region": "us-east-1",
    "AccessKey": "<aws-access-key>",
    "SecretKey": "<aws-secret-key>",
    "ServiceUrl": "<sqs-service-url-ou-vazio-para-aws-real>",
    "EmailQueueUrl": "<url-da-fila-de-email>"
  }
}
